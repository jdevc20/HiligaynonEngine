DATABASE_URL=postgresql://user:password@localhost:5432/open_hiligaynon

# Must match hilitech-auth-service JWT settings so this API can validate access tokens.
HILITECH_JWT_ACCESS_SECRET=<same-value-as-hilitech-auth-service>
HILITECH_JWT_ISSUER=hilitech-auth-service
HILITECH_JWT_AUDIENCE=hilitech-apps
